---
interface Props {
	title?: string;
	description?: string;
	activeNav?: string;
}

const { 
	title = "BONLAB — Broadband Optical Network Laboratory | RMUTI",
	description = "BONLAB (Broadband Optical Network Laboratory) researches optical communications, 128-QAM SC-FDM, underwater VLC, and real-time FPGA DSP hardware systems at RMUTI Khon Kaen Campus.",
	activeNav = ""
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="/assets/bonlab-lab-cover.jpg">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="/assets/bonlab-lab-cover.jpg">
    <link rel="stylesheet" href="/assets/style.css">
    <script is:inline>
        try {
            const savedTheme = localStorage.getItem("bonlab-theme") || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.dataset.theme = savedTheme;
            const savedLang = localStorage.getItem("bonlab-language");
            if (savedLang) document.documentElement.lang = savedLang;
        } catch (e) {}
    </script>
</head>
<body>
    <header class="site-header">
        <div class="container nav-container">
            <a href="/index.html" class="logo">
                <span class="logo-mark" aria-hidden="true">B</span>
                <span>BONLAB</span>
            </a>
            <nav class="main-nav">
                <a href="about.html" class={activeNav === 'about' ? 'active' : undefined} data-i18n="nav-about">About</a>
                <a href="research.html" class={activeNav === 'research' ? 'active' : undefined} data-i18n="nav-research">Research</a>
                <a href="partners.html" class={activeNav === 'partners' ? 'active' : undefined} data-i18n="nav-partners">Partners</a>
                <a href="news.html" class={activeNav === 'news' ? 'active' : undefined} data-i18n="nav-news">News</a>
                <a href="team.html" class={activeNav === 'team' ? 'active' : undefined} data-i18n="nav-team">Team</a>
                <a href="contact.html" class={`nav-button ${activeNav === 'contact' ? 'active' : ''}`.trim()} data-i18n="nav-contact">Contact</a>
            </nav>
            <div class="site-tools">
                <label class="language-control">
                    <span class="sr-only" data-i18n="language-label">Language</span>
                    <select class="language-select" aria-label="Language">
                        <option value="en">EN</option>
                        <option value="th">TH</option>
                        <option value="de">DE</option>
                    </select>
                </label>
                <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">🌙</button>
            </div>
            <button class="mobile-menu-button" aria-label="Open menu">
                ☰
            </button>
        </div>
    </header>

    <main>
        <slot />
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div>
                <a href="index.html" class="footer-logo">
                    BONLAB
                </a>
                <p>
                    Research · Innovation · Impact<br>
                    RMUTI Khon Kaen Campus
                </p>
            </div>
            <div>
                <h4 data-i18n="footer-explore">Explore</h4>
                <a href="about.html" data-i18n="nav-about">About</a>
                <a href="research.html" data-i18n="nav-research">Research</a>
                <a href="partners.html" data-i18n="nav-partners">Partners</a>
            </div>
            <div>
                <h4 data-i18n="footer-information">Information</h4>
                <a href="news.html" data-i18n="nav-news">News</a>
                <a href="team.html" data-i18n="nav-team">Team</a>
                <a href="contact.html" data-i18n="nav-contact">Contact</a>
            </div>
            <div>
                <h4>Connect</h4>
                <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">Facebook Page</a>
                <a href="https://sites.google.com/site/adcsbonlab/home" target="_blank" rel="noopener">Official Google Site</a>
                <a href="https://orcid.org/0000-0002-8698-5407" target="_blank" rel="noopener">ORCID Profile</a>
            </div>
        </div>
        <div class="container footer-bottom">
            © 2026 BONLAB — Broadband Optical Network Laboratory. All rights reserved.
        </div>
    </footer>

    <button id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">
        <span aria-hidden="true">↑</span>
    </button>

    <script is:inline src="/assets/script.js"></script>
</body>
</html>

