---
import Layout from "../layouts/Layout.astro";

const title = "Contact — BONLAB | Broadband Optical Network Laboratory";
const description = "Contact BONLAB at Rajamangala University of Technology Isan (RMUTI), Khon Kaen Campus. Connect with Assoc. Prof. Dr. Kidsanapong Puntsri.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            CONTACT BONLAB
        </span>

        <h1>
            Let's Collaborate & Build Research
        </h1>

        <p>
            Connect with us to discuss joint research projects, graduate student opportunities, or FPGA digital hardware prototyping.
        </p>

    </div>

</section>


<section class="section">

    <div class="container contact-grid">

        <div>

            <span class="eyebrow">
                GET IN TOUCH
            </span>

            <h2>
                Official Laboratory Information
            </h2>

            <p>
                Broadband Optical Network Laboratory (BON LAB)<br>
                Department of Electronics and Telecommunication Engineering, Faculty of Engineering,<br>
                Rajamangala University of Technology Isan (RMUTI), Khon Kaen Campus.
            </p>


            <div class="contact-info">

                <div>

                    <strong>
                        Email Address
                    </strong>

                    <a href="mailto:kidsanapong.pu@rmuti.ac.th">kidsanapong.pu@rmuti.ac.th</a>
                    <a href="mailto:puntsri@ieee.org">puntsri@ieee.org</a>

                </div>


                <div>

                    <strong>
                        Laboratory Location
                    </strong>

                    <span>150 Srijan Road, Tambon Nai Mueang, Mueang Khon Kaen District, Khon Kaen 40000, Thailand</span>

                </div>

                <div>

                    <strong>
                        Phone
                    </strong>

                    <a href="tel:0918652766">091 865 2766</a>

                </div>

                <div>

                    <strong>
                        Online & Social Channels
                    </strong>

                    <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">Facebook Official Page</a>
                    <a href="https://www.facebook.com/groups/893539197500742" target="_blank" rel="noopener">Facebook Research Group</a>
                    <a href="https://www.youtube.com/channel/UCKpW8647_GDEORLrdKXUJuA" target="_blank" rel="noopener">YouTube Channel</a>
                    <a href="https://sites.google.com/site/adcsbonlab/home" target="_blank" rel="noopener">Official Google Site</a>
                    <span>Instagram: @bon_laboratory</span>

                </div>

            </div>

        </div>


        <form class="contact-form" action="#" method="post">

            <label>
                Your Name
                <input
                    type="text"
                    placeholder="Enter your name"
                    required
                >
            </label>


            <label>
                Email Address
                <input
                    type="email"
                    placeholder="your.email@organization.com"
                    required
                >
            </label>


            <label>
                Subject / Topic
                <input
                    type="text"
                    placeholder="Research inquiry / Collaboration / Joining the Lab"
                    required
                >
            </label>


            <label>
                Message
                <textarea
                    rows="5"
                    placeholder="Tell us about your inquiry or proposal..."
                    required
                ></textarea>
            </label>


            <button type="submit" class="button button-primary">
                Send Inquiry →
            </button>

        </form>

    </div>

</section>
</Layout>
