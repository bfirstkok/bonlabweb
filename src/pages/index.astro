---
import Layout from "../layouts/Layout.astro";

const title = "BONLAB — Broadband Optical Network Laboratory | RMUTI";
const description = "BONLAB (Broadband Optical Network Laboratory) researches optical communications, 128-QAM SC-FDM, underwater VLC, and real-time FPGA DSP hardware systems at RMUTI Khon Kaen Campus.";
---

<Layout title={title} description={description}>
<!-- HERO -->

<section class="hero">

    <div class="container hero-grid">

        <div class="hero-content">

            <span class="eyebrow">
                OPTICAL COMMUNICATIONS · FPGA PROTOTYPING · REAL DSP
            </span>

            <h1>
                BONLAB
                <span data-i18n="hero-title">Research Built in Hardware.</span>
            </h1>

            <p data-i18n="hero-copy">
                Broadband Optical Network Laboratory (BON LAB) turns communication theory into testable digital hardware through FPGA real-time DSP, optical wireless testbeds, and academic collaboration at RMUTI Khon Kaen Campus.
            </p>

            <div class="hero-actions">

                <a href="research.html" class="button button-primary">
                    <span data-i18n="latest-news">Explore Research →</span>
                </a>

                <a href="about.html" class="button button-outline">
                    <span data-i18n="about-lab">About BONLAB</span>
                </a>

            </div>

        </div>


        <div class="hero-visual">

            <img class="hero-photo" src="assets/bonlab-lab-cover.jpg" alt="Communication test equipment inside BONLAB">

            <div class="visual-card">

                <small>
                    LABORATORY FOCUS
                </small>

                <strong>
                    <span data-i18n="lab-flow">Theory → Simulation → Hardware Prototyping</span>
                </strong>

                <p>
                    <span data-i18n="lab-caption">Head of Lab: Assoc. Prof. Dr. Kidsanapong Puntsri · IEEE Senior Member</span>
                </p>

            </div>

        </div>

    </div>

</section>


<!-- RESEARCH -->

<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                CORE CAPABILITIES
            </span>

            <h2>
                <span data-i18n="research-title">Communication Systems from Algorithms to Hardware</span>
            </h2>

            <p data-i18n="research-copy">
                Our work covers mathematical signal design, digital modulation, FPGA real-time baseband processing, and laboratory validation on physical optical and RF testbeds.
            </p>

        </div>


        <div class="card-grid three-columns">

            <a href="research.html" class="feature-card">

                <div class="card-icon">
                    📡
                </div>

                <h3>
                    Advanced Modulation Formats
                </h3>

                <p>
                    <span data-i18n="modulation-copy">Design and test 128-QAM, SC-FDM, and coherent optical OFDM for wireless and optical communications.</span>
                </p>

                <span class="card-link">
                    Explore →
                </span>

            </a>


            <a href="research.html" class="feature-card">

                <div class="card-icon">
                    🧩
                </div>

                <h3>
                    FPGA Prototyping & Real DSP
                </h3>

                <p>
                    <span data-i18n="fpga-copy">Implement high-speed digital transceiver pipelines on FPGA and validate them with laboratory instruments.</span>
                </p>

                <span class="card-link">
                    Explore →
                </span>

            </a>


            <a href="research.html" class="feature-card">

                <div class="card-icon">
                    🌊
                </div>

                <h3>
                    Underwater VLC & Sensors
                </h3>

                <p data-i18n="hardware-copy">
                    Develop Visible Light Communication (VLC) systems for aquatic environmental monitoring and optical sensor networks.
                </p>

                <span class="card-link">
                    Explore →
                </span>

            </a>

        </div>

    </div>

</section>


<!-- FEATURED PROJECTS -->

<section class="section section-gray">

    <div class="container">

        <div class="section-heading split-heading">

            <div>

                <span class="eyebrow">
                    FEATURED RESEARCH
                </span>

                <h2>
                    <span data-i18n="featured-title">From Theory to Working Digital Hardware</span>
                </h2>

            </div>

            <a href="research.html" class="text-link">
                View all research →
            </a>

        </div>


        <div class="project-grid">

            <article class="project-card">

                <img class="project-image" src="assets/research-128qam-scfdm.jpg" alt="128-QAM SC-FDM Optical Wireless Communication System">

                <div class="project-content">

                    <small>
                        OPTICAL WIRELESS COMMUNICATIONS
                    </small>

                    <h3>
                        128-QAM SC-FDM Optical Wireless System
                    </h3>

                    <p data-i18n="digital-project-copy">
                        High spectral efficiency modulation combined with SC-FDM to achieve low PAPR and reliable transmission over optical channels.
                    </p>

                    <a href="research-detail.html">
                        <span data-i18n="read-details">Read details →</span>
                    </a>

                </div>

            </article>


            <article class="project-card">

                <img class="project-image" src="assets/bonlab-lab-cover.jpg" alt="Underwater Environmental Monitoring using VLC">

                <div class="project-content">

                    <small>
                        VISIBLE LIGHT COMMUNICATION
                    </small>

                    <h3>
                        Underwater Monitoring using VLC
                    </h3>

                    <p>
                        Optical wireless sensor networking in aquatic environments where radio frequency signals attenuate rapidly.
                    </p>

                    <a href="research.html">
                        View project →
                    </a>

                </div>

            </article>


            <article class="project-card">

                <img class="project-image" src="assets/news-16qam.jpg" alt="FPGA Real-Time Transceiver and Low Phase-Noise PLL">

                <div class="project-content">

                    <small>
                        HARDWARE PROTOTYPING
                    </small>

                    <h3>
                        Real DSP for High Speed Transceivers
                    </h3>

                    <p>
                        Design of low phase-noise phase-locked loops (PLL) and baseband transceiver hardware engines on FPGA.
                    </p>

                    <a href="contact.html">
                        Discuss collaboration →
                    </a>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- NEWS -->

<section class="section">

    <div class="container">

        <div class="section-heading split-heading">

            <div>

                <span class="eyebrow">
                    LATEST NEWS & ACTIVITIES
                </span>

                <h2>
                    <span data-i18n="news-title">Latest Updates from BONLAB</span>
                </h2>

            </div>

            <a href="news.html" class="text-link">
                <span data-i18n="all-news">View all news →</span>
            </a>

        </div>


        <div class="news-grid">

            <article class="news-feature">

                <img class="news-feature-image" src="assets/research-128qam-scfdm.jpg" alt="128-QAM SC-FDM Optical Wireless Transmission">

                <div class="news-feature-content">

                    <span class="date">
                        RESEARCH HIGHLIGHT · LAB UPDATE
                    </span>

                    <h3>
                        Successful Transmission of 128-QAM SC-FDM over Optical Wireless Channel
                    </h3>

                    <p>
                        BONLAB researchers validated 128-QAM single-carrier FDM signals over an optical wireless testbed with real-time FPGA signal processing and low PAPR performance.
                    </p>

                    <a href="news-detail.html">
                        Read full story →
                    </a>

                </div>

            </article>


            <div class="news-side">

                <article class="news-list-item">

                    <img class="small-image" src="assets/news-16qam.jpg" alt="EECON Best Paper Award">

                    <div>

                        <span class="date">
                            AWARD · EECON
                        </span>

                        <h4>
                            Best Paper Awards from EECON-38 & EECON-40 Conferences
                        </h4>

                        <a href="news.html">
                            View details →
                        </a>

                    </div>

                </article>


                <article class="news-list-item">

                    <img class="small-image" src="assets/news-nursing-project.jpg" alt="Student Innovation and Smart Healthcare Mini-Projects">

                    <div>

                        <span class="date">
                            STUDENT MENTORING · INNOVATION
                        </span>

                        <h4>
                            Mentoring Engineering Students on Smart Sensors & Arduino Projects
                        </h4>

                        <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">
                            View on Facebook →
                        </a>

                    </div>

                </article>

            </div>

        </div>

    </div>

</section>


<!-- CTA -->

<section class="cta-section">

    <div class="container">

        <div class="cta-box">

            <span class="eyebrow light">
                COLLABORATE WITH US
            </span>

            <h2>
                Let's Build the Future Through Research.
            </h2>

            <p>
                Interested in research collaboration, industry partnerships, or joining BONLAB as a graduate researcher?
            </p>

            <a href="contact.html" class="button button-white">
                Contact BONLAB →
            </a>

        </div>

    </div>

</section>

<!-- STATS -->

<section class="stats-section stats-section-bottom" aria-labelledby="community-title">
    <div class="container">
        <div class="section-heading compact-heading">
            <span class="eyebrow">LABORATORY IMPACT</span>
            <h2 id="community-title" data-i18n="community-title">Research & Community Presence</h2>
        </div>
        <div class="stats-grid">
            <div class="stat">
                <strong>740+</strong>
                <span data-i18n="facebook-followers">Facebook Followers</span>
            </div>
            <div class="stat">
                <strong>IEEE</strong>
                <span data-i18n="following">Senior Member Lab</span>
            </div>
            <div class="stat">
                <strong>128-QAM</strong>
                <span data-i18n="always-open">SC-FDM Hardware Success</span>
            </div>
            <div class="stat">
                <strong>RMUTI</strong>
                <span data-i18n="technology-innovation">Khon Kaen Campus</span>
            </div>
        </div>
    </div>
</section>
</Layout>
