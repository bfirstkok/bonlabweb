---
import Layout from "../layouts/Layout.astro";
import researchList from "../data/research.json";

const defaultProject = researchList[0];
const title = `${defaultProject.title} — BONLAB`;
const description = defaultProject.summary;
---

<Layout title={title} description={description}>
<!-- DETAIL HERO -->
<section class="page-hero">
    <div class="container">
        <a href="research.html" class="back-link">← กลับไปหน้ารวมงานวิจัย (Back to Research)</a>
        <span class="eyebrow" id="detail-category">{defaultProject.category}</span>
        <h1 id="detail-title">{defaultProject.title}</h1>
        <p id="detail-th-title" style="font-size: 17px; color: #cbd8f5; margin-top: 8px;">{defaultProject.titleTh}</p>
        <p id="detail-summary" style="font-size: 15px; max-width: 800px; margin-top: 10px;">{defaultProject.summary}</p>

    </div>
</section>

<!-- MAIN DETAIL CONTENT WITH INTERACTIVE PROJECT TABS -->
<section class="section">
    <div class="container detail-layout">
        <article class="detail-content">
            <img id="detail-image" class="project-image" src={defaultProject.image} alt={defaultProject.title}>
            
            <h2>บทคัดย่อและการดำเนินงานวิจัย (Executive Summary)</h2>
            <p id="detail-body-text">{defaultProject.content}</p>

            <h2>จุดเด่นและความก้าวหน้าทางวิศวกรรม (Technical Highlights)</h2>
            <ul id="detail-highlights" class="detail-list">
                {defaultProject.highlights.map((h) => <li><strong>{h}</strong></li>)}
            </ul>

            <h2>การทดสอบในห้องปฏิบัติการและฮาร์ดแวร์จริง (Lab Testbed & Verification)</h2>
            <p>
                งานวิจัยนี้ดำเนินการทดสอบและสังเคราะห์ระบบจริงภายในห้องปฏิบัติการ <strong>BON LAB (Broadband Optical Network Laboratory)</strong> 
                สาขาวิชาวิศวกรรมอิเล็กทรอนิกส์และโทรคมนาคม คณะวิศวกรรมศาสตร์ มหาวิทยาลัยเทคโนโลยีราชมงคลอีสาน วิทยาเขตขอนแก่น 
                โดยใช้อุปกรณ์ตรวจวัดความถี่สูง เครื่องกำเนิดสัญญาณคลื่นความถี่กว้าง (AWG) และออสซิลโลสโคปแบบ Real-time ร่วมกับชุดทดสอบออปติคอล
            </p>

            <!-- Call to Action: Official Paper Link -->
            <div class="cta-box" style="margin-top: 40px; padding: 28px; background: var(--surface); border: 1.5px solid var(--primary); text-align: left; border-radius: 12px;">
                <span class="eyebrow" style="color: var(--primary);">OFFICIAL PUBLICATION & CITATION</span>
                <h3 style="margin: 8px 0 12px; font-size: 20px;">สนใจอ่านเอกสารทางวิชาการและผลการทดลองฉบับเต็ม?</h3>
                <p style="margin-bottom: 18px; font-size: 14px; color: var(--muted);">
                    บทความวิจัยนี้ได้รับการตรวจสอบจากผู้ทรงคุณวุฒิ (Peer-Reviewed) และตีพิมพ์เผยแพร่ในฐานข้อมูลระดับนานาชาติ 
                    <span id="detail-journal-badge" style="font-weight: 700; color: var(--text);">[{defaultProject.journal}]</span>
                </p>
                <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
                    <a id="detail-paper-btn" class="button button-primary" href={defaultProject.paperUrl} target="_blank" rel="noopener">
                        🔗 อ่านบทความวิจัยฉบับเต็ม (Publisher / DOI) ↗
                    </a>
                    <a class="text-link" href="https://orcid.org/0000-0002-8698-5407" target="_blank" rel="noopener">
                        โปรไฟล์ Scopus / ORCID ของ รศ.ดร.กฤษณะพงศ์ ↗
                    </a>
                </div>
            </div>
        </article>

        <aside class="detail-sidebar">
            <div class="sidebar-card">
                <h3>Research Specifications</h3>
                <div class="info-row"><span>Field</span><strong id="spec-field">{defaultProject.specs.field}</strong></div>
                <div class="info-row"><span>Hardware / Tech</span><strong id="spec-tech">{defaultProject.specs.technology || defaultProject.specs.platform || defaultProject.specs.standard}</strong></div>
                <div class="info-row"><span>Publisher</span><strong id="spec-journal">{defaultProject.journal}</strong></div>
                <div class="info-row"><span>DOI</span><strong id="spec-doi">{defaultProject.doi}</strong></div>
                <div class="info-row"><span>Lab</span><strong>BONLAB</strong></div>
                <div class="info-row"><span>Campus</span><strong>RMUTI Khon Kaen</strong></div>
            </div>
            
            <div class="sidebar-card">
                <h3>Principal Investigator</h3>
                <p><strong>Assoc. Prof. Dr. Kidsanapong Puntsri</strong></p>
                <p>รศ.ดร.กฤษณะพงศ์ พันธ์ศรี</p>
                <p style="font-size: 12.5px; color: var(--muted);">Head of BON LAB · IEEE Senior Member</p>
                <a class="text-link" href="mailto:kidsanapong.pu@rmuti.ac.th">kidsanapong.pu@rmuti.ac.th</a>
            </div>

            <div class="sidebar-card">
                <h3>บทความวิจัยอื่นใน BONLAB</h3>
                <div id="other-research-links">
                    {researchList.map((item) => (
                        <p style="margin-bottom: 10px;">
                            <a class="text-link" href={`research-detail.html?id=${item.id}`}>
                                → {item.title}
                            </a>
                        </p>
                    ))}
                </div>
            </div>
        </aside>

    </div>
</section>

<!-- Client Script to populate page dynamically based on URL parameter ?id=... -->
<script define:vars={{ researchList }}>
    function loadResearchDetail() {
        const params = new URLSearchParams(window.location.search);
        const id = params.get('id') || (researchList[0] && researchList[0].id);
        const project = researchList.find(item => item.id === id) || researchList[0];
        if (!project) return;

        document.title = `${project.title} — BONLAB`;
        const titleEl = document.getElementById('detail-title');
        const thTitleEl = document.getElementById('detail-th-title');
        const catEl = document.getElementById('detail-category');
        const summaryEl = document.getElementById('detail-summary');
        const imgEl = document.getElementById('detail-image');
        const bodyEl = document.getElementById('detail-body-text');
        const highlightsEl = document.getElementById('detail-highlights');
        const paperBtn = document.getElementById('detail-paper-btn');
        const journalBadge = document.getElementById('detail-journal-badge');
        const specField = document.getElementById('spec-field');
        const specTech = document.getElementById('spec-tech');
        const specJournal = document.getElementById('spec-journal');
        const specDoi = document.getElementById('spec-doi');

        if (titleEl) titleEl.textContent = project.title;
        if (thTitleEl) thTitleEl.textContent = project.titleTh;
        if (catEl) catEl.textContent = project.category;
        if (summaryEl) summaryEl.textContent = project.summary;
        if (imgEl) {
            imgEl.src = project.image;
            imgEl.alt = project.title;
        }
        if (bodyEl) bodyEl.textContent = project.content;
        if (journalBadge) journalBadge.textContent = `[${project.journal}]`;
        if (paperBtn) paperBtn.href = project.paperUrl;

        if (specField) specField.textContent = project.specs.field || '-';
        if (specTech) specTech.textContent = project.specs.technology || project.specs.platform || project.specs.standard || project.specs.modulation || '-';
        if (specJournal) specJournal.textContent = project.journal || '-';
        if (specDoi) specDoi.textContent = project.doi || '-';

        if (highlightsEl && project.highlights) {
            highlightsEl.innerHTML = project.highlights.map(h => `<li><strong>${h}</strong></li>`).join('');
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadResearchDetail);
    } else {
        loadResearchDetail();
    }
</script>
</Layout>
