---
import Layout from "../layouts/Layout.astro";

const title = "About — BONLAB | Broadband Optical Network Laboratory";
const description = "Broadband Optical Network Laboratory (BONLAB) is a research laboratory for wireless, optical and digital communication systems at RMUTI Khon Kaen Campus.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            ABOUT BONLAB
        </span>

        <h1>
            Broadband Optical Network Laboratory
        </h1>

        <p>
            A dedicated research laboratory for wireless, optical, and digital communication systems — from mathematical signal design to working hardware prototypes on FPGA and optical testbeds.
        </p>

    </div>

</section>


<section class="section">

    <div class="container about-grid">

        <img class="profile-photo" src="assets/researcher-kidsanapong.jpg" alt="รศ.ดร.กฤษณะพงศ์ พันธ์ศรี (Assoc. Prof. Dr. Kidsanapong Puntsri)">

        <div>

            <span class="eyebrow">
                LAB DIRECTOR & FOUNDER
            </span>

            <h2 data-i18n="researcher-name">
                Assoc. Prof. Dr. Kidsanapong Puntsri
            </h2>

            <p>
                <strong>รศ.ดร.กฤษณะพงศ์ พันธ์ศรี</strong> is an Associate Professor and Head of the Broadband Optical Network Laboratory (BON LAB) in the Department of Electronics and Telecommunication Engineering, Faculty of Engineering, Rajamangala University of Technology Isan (RMUTI), Khon Kaen Campus.
            </p>

            <p>
                His primary research focuses on advanced optical communication systems, high-order modulation formats (such as 128-QAM SC-FDM), real-time DSP on FPGA, low phase-noise phase-locked loops (PLL), and Visible Light Communications (VLC).
            </p>

            <p>
                He has served as an active reviewer for top-tier international journals including <em>IEEE Transactions on Signal Processing</em>, <em>IEEE Communications Letters</em>, <em>Elsevier Optical Fiber Technology</em>, and <em>IEEE Photonics Technology Letters</em>.
            </p>

            <p><a class="text-link" href="https://orcid.org/0000-0002-8698-5407" target="_blank" rel="noopener">View Scopus & ORCID Profile (0000-0002-8698-5407) →</a></p>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                ACADEMIC BACKGROUND
            </span>

            <h2>
                Education and qualifications
            </h2>

        </div>


        <div class="card-grid three-columns">

            <div class="feature-card">
                <h3>🎯 Bachelor of Engineering</h3>
                <p><strong>Telecommunication Engineering</strong><br>Mahanakorn University of Technology.<br>Senior project focused on high-frequency radio receiver design.</p>
            </div>

            <div class="feature-card">
                <h3>🔭 Master of Engineering</h3>
                <p><strong>Telecommunication Engineering</strong><br>King Mongkut's Institute of Technology Ladkrabang (KMITL).<br>Research in satellite communication and traffic analysis.</p>
            </div>

            <div class="feature-card">
                <h3>🤝 Dr.-Ing. (Ph.D.)</h3>
                <p><strong>Optical Communication Systems</strong><br>The University of Paderborn, Germany.<br>Dissertation on advanced receivers for coherent optical OFDM systems.</p>
            </div>

        </div>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                CAREER & RECOGNITION
            </span>

            <h2>
                Academic milestones
            </h2>

        </div>


        <div class="timeline">

            <div class="timeline-item">
                <span class="timeline-date">2021 – Present</span>
                <div>
                    <h3>Associate Professor (รศ.)</h3>
                    <p>Department of Electronics and Telecommunication Engineering, RMUTI Khon Kaen Campus. Leading research in FPGA digital communications, VLC, and optical networks.</p>
                </div>
            </div>

            <div class="timeline-item">
                <span class="timeline-date">May 2018</span>
                <div>
                    <h3>IEEE Senior Member Elevation</h3>
                    <p>Conferred Senior Member status by the Institute of Electrical and Electronics Engineers (IEEE) in recognition of significant professional standing.</p>
                </div>
            </div>

            <div class="timeline-item">
                <span class="timeline-date">2016 – 2021</span>
                <div>
                    <h3>Assistant Professor (ผศ.)</h3>
                    <p>Faculty of Engineering, RMUTI Khon Kaen Campus. Head of BON LAB and director of graduate research programs.</p>
                </div>
            </div>

            <div class="timeline-item">
                <span class="timeline-date">2007 – 2016</span>
                <div>
                    <h3>Lecturer & Researcher</h3>
                    <p>Faculty of Engineering, Rajamangala University of Technology Isan.</p>
                </div>
            </div>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                FACILITIES & INSTRUMENTATION
            </span>

            <h2>
                Laboratory equipment & capabilities
            </h2>

            <p>
                BONLAB is equipped with state-of-the-art instruments for high-frequency testing, optical signal analysis, and FPGA hardware prototyping.
            </p>

        </div>


        <div class="card-grid three-columns">

            <div class="feature-card">
                <div class="card-icon">⚡</div>
                <h3>FPGA Prototyping Systems</h3>
                <p>High-capacity Xilinx & Intel FPGA development boards for real-time DSP, constellation mapping, and baseband transceiver pipeline testing.</p>
            </div>

            <div class="feature-card">
                <div class="card-icon">🔬</div>
                <h3>Optical & Photonic Testbeds</h3>
                <p>Visible Light Communication (VLC) transmitter-receiver benches, semiconductor laser drivers, avalanche photodetectors, and optical power meters.</p>
            </div>

            <div class="feature-card">
                <div class="card-icon">📊</div>
                <h3>RF & Mixed-Signal Analysis</h3>
                <p>High-bandwidth digital storage oscilloscopes, RF spectrum analyzers, arbitrary waveform generators, and low phase noise PLL characterization setups.</p>
            </div>

        </div>

    </div>

</section>
</Layout>
