---
import Layout from "../layouts/Layout.astro";

const title = "News & Activities — BONLAB | Broadband Optical Network Laboratory";
const description = "Latest research news, conference awards, laboratory experiments, and student activities from BONLAB at RMUTI Khon Kaen Campus.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            NEWS & ACTIVITIES
        </span>

        <h1>
            Latest from BONLAB
        </h1>

        <p>
            Stay updated with our laboratory breakthroughs, academic awards, student mentorship projects, and knowledge sharing activities.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="news-filter">

            <button class="filter-button active">
                All
            </button>

            <button class="filter-button">
                Research & Experiments
            </button>

            <button class="filter-button">
                Awards
            </button>

            <button class="filter-button">
                Student Projects
            </button>

            <button class="filter-button">
                Seminars & Learning
            </button>

        </div>


        <p class="source-note">Follow our official updates on Facebook: <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">BONLAB Facebook Page</a></p>

        <div class="news-card-grid">

            <article class="news-card">

                <img class="news-card-image" src="assets/research-128qam-scfdm.jpg" alt="128-QAM SC-FDM Optical Wireless Communication Success">

                <div class="news-card-content">

                    <span class="date">
                        RESEARCH HIGHLIGHT · LAB MILESTONE
                    </span>

                    <h2>
                        Successful Transmission of 128-QAM SC-FDM over Optical Wireless Channel
                    </h2>

                    <p>
                        BONLAB researchers achieved a breakthrough in optical wireless communications by successfully transmitting and demodulating 128-QAM Single-Carrier FDM signals using FPGA real-time DSP pipelines.
                    </p>

                    <a href="news-detail.html">
                        Read full story →
                    </a>

                </div>

            </article>


            <article class="news-card">

                <img class="news-card-image" src="assets/news-16qam.jpg" alt="Dr. Kidsanapong Puntsri receives Best Paper Award at EECON">

                <div class="news-card-content">

                    <span class="date">
                        CONFERENCE AWARD · EECON
                    </span>

                    <h2>
                        Dr. Kidsanapong Puntsri Receives Best Paper Award at EECON Conference
                    </h2>

                    <p>
                        Recognized for outstanding technical contribution and excellence in communication engineering research at the Electrical Engineering Conference (EECON).
                    </p>

                    <a href="news-detail.html">
                        Read details →
                    </a>

                </div>

            </article>


            <article class="news-card">

                <img class="news-card-image" src="assets/news-nursing-project.jpg" alt="Mentoring Engineering Students on Smart Healthcare Mini-Projects">

                <div class="news-card-content">

                    <span class="date">
                        STUDENT MENTORING · INNOVATION
                    </span>

                    <h2>
                        Mentoring Students on Smart Healthcare & Sensor Mini-Projects
                    </h2>

                    <p>
                        Assoc. Prof. Dr. Kidsanapong provided hands-on coaching to engineering and multidisciplinary students on Arduino microcontroller programming, electronic circuit soldering, and sensor interfacing.
                    </p>

                    <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">
                        View on Facebook →
                    </a>

                </div>

            </article>


            <article class="news-card">

                <img class="news-card-image" src="assets/news-optical-sensor.jpg" alt="Knowledge Sharing Seminar on Optical Sensors">

                <div class="news-card-content">

                    <span class="date">
                        LEARNING · GUEST LECTURE
                    </span>

                    <h2>
                        Optical Sensors & Practical Engineering Seminar
                    </h2>

                    <p>
                        A special session featuring university-network guest speakers sharing practical engineering insights, optical sensor principles, and laboratory testing methodologies.
                    </p>

                    <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">
                        View on Facebook →
                    </a>

                </div>

            </article>


            <article class="news-card">

                <img class="news-card-image" src="assets/bonlab-lab-cover.jpg" alt="Doctoral Seminar and Research Exchange at RMUTI Khon Kaen">

                <div class="news-card-content">

                    <span class="date">
                        GRADUATE STUDIES · SEMINAR
                    </span>

                    <h2>
                        Doctoral Seminar & Research Exchange at RMUTI Khon Kaen
                    </h2>

                    <p>
                        Graduate students in the Electrical and Computer Engineering doctoral program presented progress on advanced digital transceiver design and low phase-noise PLL circuits.
                    </p>

                    <a href="about.html">
                        Explore research topics →
                    </a>

                </div>

            </article>

        </div>

    </div>

</section>
</Layout>
