---
import Layout from "../layouts/Layout.astro";
import newsPosts from "../data/news.json";

const title = "News & Activities — BONLAB | Broadband Optical Network Laboratory";
const description = "Latest research news, conference awards, laboratory experiments, and student activities from BONLAB at RMUTI Khon Kaen Campus.";
---

<Layout title={title} description={description} activeNav="news">
<section class="page-hero">

    <div class="container">

        <span class="eyebrow" data-i18n="news-hero-eyebrow">
            NEWS & ACTIVITIES
        </span>

        <h1 data-i18n="news-page-title">
            Latest from BONLAB
        </h1>

        <p data-i18n="news-page-copy">
            Stay updated with our laboratory breakthroughs, academic awards, student mentorship projects, and knowledge sharing activities.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="news-controls-row">

            <div class="search-box-wrapper">
                <span class="search-icon" aria-hidden="true">🔍</span>
                <input 
                    type="search" 
                    id="news-search" 
                    class="news-search-input" 
                    placeholder="Search news, topics, keywords..." 
                    data-i18n-placeholder="news-search-placeholder"
                    aria-label="Search news articles"
                />
            </div>

            <div class="news-filter">

                <button type="button" class="filter-button active" data-filter="all" data-i18n="news-filter-all">
                    All
                </button>

                <button type="button" class="filter-button" data-filter="research" data-i18n="news-filter-research">
                    Research & Experiments
                </button>

                <button type="button" class="filter-button" data-filter="awards" data-i18n="news-filter-awards">
                    Awards
                </button>

                <button type="button" class="filter-button" data-filter="students" data-i18n="news-filter-students">
                    Student Projects
                </button>

                <button type="button" class="filter-button" data-filter="seminars" data-i18n="news-filter-seminars">
                    Seminars & Learning
                </button>

            </div>

        </div>

        <p class="source-note">
            <span data-i18n="news-source-note">Follow our official updates on Facebook:</span> 
            <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener">
                <strong>BONLAB Facebook Page ↗</strong>
            </a>
        </p>

        <div id="no-news-found" class="no-results" style="display: none;">
            <p>🔍 <span data-i18n="no-news-found">No news articles found matching your search.</span></p>
        </div>

        <div class="news-layout-wrapper">

            <!-- MAIN COLUMN: LAB ARTICLES & NEWS -->
            <div class="news-main-column">
                <div class="news-card-grid">

                    <article class="news-card" data-category="research">

                        <img class="news-card-image" src="assets/research-128qam-scfdm.jpg" alt="128-QAM SC-FDM Optical Wireless Communication Success" loading="lazy">

                        <div class="news-card-content">

                            <div class="news-badge news-badge-article">
                                <span data-i18n="badge-article">Lab Article</span>
                            </div>

                            <span class="date">
                                RESEARCH HIGHLIGHT · LAB MILESTONE
                            </span>

                            <h2>
                                Successful Transmission of 128-QAM SC-FDM over Optical Wireless Channel
                            </h2>

                            <p>
                                BONLAB researchers achieved a breakthrough in optical wireless communications by successfully transmitting and demodulating 128-QAM Single-Carrier FDM signals using FPGA real-time DSP pipelines.
                            </p>

                            <a href="news-detail.html">
                                <span data-i18n="read-full-story">Read full story →</span>
                            </a>

                        </div>

                    </article>


                    <article class="news-card" data-category="awards">

                        <img class="news-card-image" src="assets/news-16qam.jpg" alt="Dr. Kidsanapong Puntsri receives Best Paper Award at EECON" loading="lazy">

                        <div class="news-card-content">

                            <div class="news-badge news-badge-award">
                                <span data-i18n="badge-award">Award & Paper</span>
                            </div>

                            <span class="date">
                                CONFERENCE AWARD · EECON
                            </span>

                            <h2>
                                Dr. Kidsanapong Puntsri Receives Best Paper Award at EECON Conference
                            </h2>

                            <p>
                                Recognized for outstanding technical contribution and excellence in communication engineering research at the Electrical Engineering Conference (EECON).
                            </p>

                            <a href="news-detail.html">
                                <span data-i18n="read-full-story">Read full story →</span>
                            </a>

                        </div>

                    </article>


                    <article class="news-card" data-category="students awards">

                        <img class="news-card-image" src="assets/news-nursing-project.jpg" alt="National Silver Medal - Smart Photonic Vital-Sign Monitor" loading="lazy">

                        <div class="news-card-content">

                            <div class="news-badge news-badge-award">
                                <span data-i18n="badge-award">Award & Paper</span>
                            </div>

                            <span class="date">
                                AWARD & STUDENT MENTORING · THAILAND RESEARCH EXPO
                            </span>

                            <h2>
                                National Silver Medal Award: Smart Photonic Vital-Sign IoT Monitor
                            </h2>

                            <p>
                                Undergraduate engineering team under BONLAB mentorship received the Silver Medal at the Thailand Research Expo for an IoT vital-sign telemetry monitoring system.
                            </p>

                            <a href="research-detail.html#p4">
                                <span data-i18n="view-project-details">View project details →</span>
                            </a>

                        </div>

                    </article>

                    {newsPosts && newsPosts.map((post) => (
                        <article class="news-card" data-category={post.category ? post.category.toLowerCase() : "seminars"}>
                            <div class="news-card-image-wrap">
                                <img 
                                    class="news-card-image" 
                                    src={post.image} 
                                    alt={post.title}
                                    loading="lazy"
                                />
                            </div>
                            <div class="news-card-content">
                                <div class="news-badge news-badge-facebook">
                                    <span data-i18n="badge-facebook">Facebook Activity</span>
                                </div>
                                <span class="date">
                                    {post.category}
                                </span>
                                <h2>
                                    {post.title}
                                </h2>
                                <p>
                                    {post.excerpt}
                                </p>
                                <a 
                                    href={post.facebookUrl || "https://web.facebook.com/profile.php?id=100076231050286"} 
                                    target="_blank" 
                                    rel="noopener" 
                                    class="news-card-fb-link"
                                >
                                    <span data-i18n="view-on-fb">View on Facebook ↗</span>
                                </a>
                            </div>
                        </article>
                    ))}

                </div>
            </div>

            <!-- SIDEBAR: LIVE FACEBOOK FEED WIDGET -->
            <aside class="news-sidebar">
                <div class="fb-feed-card">
                    <div class="fb-feed-header">
                        <div class="fb-logo-icon" aria-hidden="true">f</div>
                        <div class="fb-feed-header-text">
                            <h3 data-i18n="news-fb-live-title">BONLAB Live Feed</h3>
                            <p data-i18n="news-fb-live-desc">อัปเดตกิจกรรมสดจาก Facebook</p>
                        </div>
                    </div>

                    <div class="fb-iframe-container">
                        <iframe 
                            src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fprofile.php%3Fid%3D100076231050286&tabs=timeline&width=340&height=500&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId=" 
                            width="340" 
                            height="500" 
                            style="border:none;overflow:hidden;width:100%;max-width:340px;height:500px;" 
                            scrolling="no" 
                            frameborder="0" 
                            allowfullscreen="true" 
                            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                            loading="lazy"
                            title="BONLAB Official Facebook Page Feed">
                        </iframe>
                    </div>

                    <a href="https://web.facebook.com/profile.php?id=100076231050286" target="_blank" rel="noopener" class="fb-direct-link-btn">
                        <span data-i18n="news-fb-open-btn">เปิดดูบน Facebook App / Web ↗</span>
                    </a>
                </div>
            </aside>

        </div>

    </div>

</section>
</Layout>

