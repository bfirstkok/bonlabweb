      <h3 data-en="Graduate Students" data-th="นักศึกษาระดับบัณฑิตศึกษา">Graduate Students</h3>
      <span class="count-badge" data-en="4 Researchers" data-th="4 นักวิจัย">4 Researchers</span>
    </div>

    <div class="student-vertical-list">

      <!-- Student 1: Bussakorn Bunsri -->
      <article class="student-card-vertical">
        <div class="student-photo-col">
          <img 
            src="/assets/team/student_bussakorn.jpg" 
            alt="M.Eng. Bussakorn Bunsri" 
            onerror="this.onerror=null; this.src='/assets/team/avatar-student.svg'" 
          />
        </div>
        <div class="student-content-col">
