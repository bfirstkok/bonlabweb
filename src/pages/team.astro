---
import Layout from "../layouts/Layout.astro";

const title = "Teams — BONLAB | Broadband Optical Network Laboratory";
const description = "Meet the researchers, graduate students, and undergraduate engineering teams at BONLAB, RMUTI Khon Kaen Campus led by Assoc. Prof. Dr. Kidsanapong Puntsri.";
---

<Layout title={title} description={description}>
<main>
<section class="page-hero">
  <div class="container text-center">
    <span class="eyebrow" data-en="OUR PEOPLE & RESEARCH TEAMS" data-th="บุคลากรและคณะทำงานวิจัย">OUR PEOPLE & RESEARCH TEAMS</span>
    <h1 data-en="The People Behind BONLAB" data-th="คณะทำงานและนักวิจัยห้องปฏิบัติการ BONLAB">The People Behind BONLAB</h1>
    <p data-en="Faculty leadership, doctoral researchers, graduate students, and undergraduate engineering teams innovating in FPGA DSP, Optical Wireless, and Telecommunication systems at RMUTI Khon Kaen Campus." data-th="คณาจารย์ นักวิจัยระดับปริญญาเอก นักศึกษาปริญญาโท และทีมโครงงานวิศวกรรม ร่วมสร้างสรรค์นวัตกรรม FPGA DSP ระบบสื่อสารเชิงแสงและโทรคมนาคม ณ มทร.อีสาน วิทยาเขตขอนแก่น">Faculty leadership, doctoral researchers, graduate students, and undergraduate engineering teams innovating in FPGA DSP, Optical Wireless, and Telecommunication systems at RMUTI Khon Kaen Campus.</p>
  </div>
</section>

<section class="section team-layout-section">
  <div class="container team-vertical-container">

    <!-- 1. LAB LEADERSHIP / DIRECTOR -->
    <div class="team-section-heading-row">
      <h3 data-en="Lab Director & Founder" data-th="หัวหน้าห้องปฏิบัติการวิจัยและผู้ก่อตั้ง">Lab Director & Founder</h3>
      <span class="count-badge" data-en="Principal Investigator" data-th="หัวหน้าโครงการวิจัย">Principal Investigator</span>
    </div>

    <article class="team-director-vertical-card">
      <div class="student-photo-col">
        <img 
          src="/assets/researcher-kidsanapong.jpg" 
          alt="Assoc. Prof. Dr. Kidsanapong Puntsri" 
          onerror="this.onerror=null; this.src='/assets/team/avatar-student.svg'" 
        />
      </div>
      <div class="student-content-col">
        <div class="student-badge-row">
          <span class="badge-student-degree" data-en="Lab Director & Founder" data-th="หัวหน้าห้องปฏิบัติการ">Lab Director & Founder</span>
          <span class="badge-grad-year">IEEE Senior Member</span>
        </div>
        <div class="student-header-title">
          <h2 class="student-name-main" data-en="Assoc. Prof. Dr. Kidsanapong Puntsri" data-th="รศ.ดร.กฤษณะพงศ์ พันธ์ศรี">Assoc. Prof. Dr. Kidsanapong Puntsri</h2>
        </div>
        <p class="student-affiliation-text" data-en="Assoc. Prof. Dr. Kidsanapong Puntsri · IEEE Senior Member · Dr.-Ing. · Department of Electronics and Telecommunication Engineering, Faculty of Engineering, RMUTI Khon Kaen Campus, Thailand." data-th="รศ.ดร.กฤษณะพงศ์ พันธ์ศรี · สมาชิกอาวุโส IEEE · Dr.-Ing. · สาขาวิชาวิศวกรรมอิเล็กทรอนิกส์และโทรคมนาคม คณะวิศวกรรมศาสตร์ มทร.อีสาน วิทยาเขตขอนแก่น">
          Assoc. Prof. Dr. Kidsanapong Puntsri · IEEE Senior Member · Dr.-Ing. · Department of Electronics and Telecommunication Engineering, Faculty of Engineering, RMUTI Khon Kaen Campus, Thailand.
        </p>
        <div class="student-project-box">
          <span class="student-project-heading" data-en="Core Research Areas" data-th="ความเชี่ยวชาญและทิศทางการวิจัย">Core Research Areas</span>
          <p class="student-project-title" data-en="Optical Wireless Communications (OWC/VLC), Real-Time FPGA DSP, Coherent Optical OFDM & Space Payload Communication Systems" data-th="การสื่อสารไร้สายเชิงแสง (OWC/VLC), การประมวลผลสัญญาณ FPGA แบบเรียลไทม์, Coherent Optical OFDM และระบบสื่อสารอุปกรณ์อวกาศ">Optical Wireless Communications (OWC/VLC), Real-Time FPGA DSP, Coherent Optical OFDM & Space Payload Communication Systems</p>
        </div>
        <div class="team-member-links" style="margin-top: 2px;">
          <a href="https://orcid.org/0000-0002-8698-5407" target="_blank" rel="noopener">Scopus / ORCID (0000-0002-8698-5407) ↗</a>
          <span style="margin: 0 8px; color: var(--border);">•</span>
          <a href="https://scholar.google.com/citations?user=lo9l-hMAAAAJ&hl=th&oi=ao" target="_blank" rel="noopener">Google Scholar ↗</a>
          <span style="margin: 0 8px; color: var(--border);">•</span>
          <a href="/about.html" data-en="Full Academic Profile →" data-th="ประวัติและผลงานวิชาการ →">Full Academic Profile →</a>
        </div>
      </div>
    </article>

    <!-- 2. GRADUATE STUDENTS (4 Researchers) -->
