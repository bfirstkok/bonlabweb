---
import Layout from "../layouts/Layout.astro";

const title = "Team — BONLAB | Broadband Optical Network Laboratory";
const description = "Meet the researchers, students, and collaborators at BONLAB, RMUTI Khon Kaen Campus led by Assoc. Prof. Dr. Kidsanapong Puntsri.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container text-center">

        <span class="eyebrow">
            OUR PEOPLE & RESEARCHERS
        </span>

        <h1>
            The People Behind BONLAB
        </h1>

        <p>
            Faculty, doctoral researchers, master students, and undergraduate engineers learning through hands-on system building and laboratory experiments at RMUTI Khon Kaen.
        </p>

    </div>

</section>


<section class="section team-layout-section">

    <div class="container">

        <!-- 1. แถวบน: หัวหน้าแล็บ / หัวหน้าสาขา (ตรงกลาง 1 คน) -->
        <div class="team-leader-wrap">

            <article class="team-member-card">

                <div class="team-member-photo-box">
                    <img src="/assets/researcher-kidsanapong.jpg" alt="รศ.ดร.กฤษณะพงศ์ พันธ์ศรี (Assoc. Prof. Dr. Kidsanapong Puntsri)">
                </div>

                <div class="team-member-info">

                    <h3 class="team-member-name" data-i18n="researcher-name">
                        รศ.ดร.กฤษณะพงศ์ พันธ์ศรี
                    </h3>

                    <span class="team-member-role">
                        หัวหน้าห้องปฏิบัติการวิจัย (Lab Director & Founder)
                    </span>

                    <p class="team-member-desc">
                        Assoc. Prof. Dr. Kidsanapong Puntsri · IEEE Senior Member · Dr.-Ing.
                    </p>

                    <div class="team-member-links">
                        <a href="https://orcid.org/0000-0002-8698-5407" target="_blank" rel="noopener">Scopus / ORCID Profile →</a>
                    </div>

                </div>

            </article>

        </div>


        <!-- 2. แถวล่าง: คณาจารย์ / นักวิจัย / สมาชิก (Grid 3 คอลัมน์) -->
        <div class="team-members-grid">

            <article class="team-member-card">

                <div class="team-member-photo-box">
                    <img src="/assets/researcher-kidsanapong.jpg" alt="อ.เขมวัตร อินทรวิเศษ">
                </div>

                <div class="team-member-info">
                    <h3 class="team-member-name">
                        อ.เขมวัตร อินทรวิเศษ
                    </h3>
                    <span class="team-member-role">
                        อาจารย์ประจำสาขาวิชา
                    </span>
                    <p class="team-member-desc">
                        Department Faculty & Researcher
                    </p>
                </div>

            </article>

            <article class="team-member-card">

                <div class="team-member-photo-box">
                    <img src="/assets/researcher-kidsanapong.jpg" alt="ดร.ณรงค์ สีหาจ่อง">
                </div>

                <div class="team-member-info">
                    <h3 class="team-member-name">
                        ดร.ณรงค์ สีหาจ่อง
                    </h3>
                    <span class="team-member-role">
                        อาจารย์ประจำสาขาวิชา
                    </span>
                    <p class="team-member-desc">
                        Department Faculty & Researcher
                    </p>
                </div>

            </article>

            <article class="team-member-card">

                <div class="team-member-photo-box">
                    <img src="/assets/researcher-kidsanapong.jpg" alt="ผศ.ดร.ศุภฤกษ์ ชามงคลประดิษฐ์">
                </div>

                <div class="team-member-info">
                    <h3 class="team-member-name">
                        ผศ.ดร.ศุภฤกษ์ ชามงคลประดิษฐ์
                    </h3>
                    <span class="team-member-role">
                        อาจารย์ประจำสาขาวิชา
                    </span>
                    <p class="team-member-desc">
                        Department Faculty & Researcher
                    </p>
                </div>

            </article>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                MEMBERS & COLLABORATORS
            </span>

            <h2>
                Research Groups & Students
            </h2>

            <p>
                Collaborative research across multiple levels of engineering education.
            </p>

        </div>


        <div class="card-grid three-columns">

            <div class="feature-card">
                <div class="card-icon">🎓</div>
                <h3>Doctoral & Graduate Researchers</h3>
                <p>Ph.D. and M.Eng. candidates in Electrical & Computer Engineering focusing on high-order modulation, optical wireless channels, and FPGA hardware implementations.</p>
            </div>

            <div class="feature-card">
                <div class="card-icon">⚡</div>
                <h3>Undergraduate Project Teams</h3>
                <p>Senior engineering students developing hands-on capstone projects in embedded IoT, optical sensors, Arduino controllers, and communications hardware.</p>
            </div>

            <div class="feature-card">
                <div class="card-icon">🤝</div>
                <h3>Alumni & Academic Network</h3>
                <p>Graduated alumni and collaborative researchers across university networks, research institutes, and telecommunication industries.</p>
            </div>

        </div>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="cta-box">

            <span class="eyebrow light">
                JOIN THE LAB
            </span>

            <h2>
                Interested in Joining BONLAB?
            </h2>

            <p>
                We welcome motivated undergraduate, master, and doctoral students interested in wireless, optical communications, and digital hardware.
            </p>

            <a href="contact.html" class="button button-white">
                Get in touch with us →
            </a>

        </div>

    </div>

</section>
</Layout>
