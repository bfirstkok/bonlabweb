---
import Layout from "../layouts/Layout.astro";

const title = "Partners & Collaborators — BONLAB";
const description = "Academic, space research, computer engineering, industry, and government partners collaborating with BONLAB, RMUTI Khon Kaen Campus.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow" data-i18n="partners-hero-eyebrow">
            COLLABORATION & ALLIANCES
        </span>

        <h1 data-i18n="partners-hero-title">
            Research Strengthened through Strategic Partnership
        </h1>

        <p data-i18n="partners-hero-copy">
            BONLAB actively collaborates with international space exploration missions, computer and electrical engineering departments, academic institutions, schools, and national research funding bodies.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <!-- 1. Deep Space & Lunar Exploration (Paired 2 Items - Symmetrical 2 Columns) -->
        <h3 class="subsection-title" data-i18n="partners-sec1-title">
            Deep Space & Lunar Exploration Mission
        </h3>

        <div class="partner-grid-2">

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/narit.svg" alt="NARIT Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-narit-title">National Astronomical Research Institute of Thailand (NARIT)</h3>
                <p data-i18n="partner-narit-desc">สถาบันวิจัยดาราศาสตร์แห่งชาติ (สดร.) · Thailand–China Chang'E-7 (CE-7) Lunar Exploration Mission & CE-7 MATCH instrument payload development.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/ciomp.png" alt="CIOMP / CAS Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-ciomp-title">CIOMP / Chinese Academy of Sciences (CAS)</h3>
                <p data-i18n="partner-ciomp-desc">Changchun Institute of Optics, Fine Mechanics and Physics · Space radiation detection & FPGA communication architecture for lunar research (ILRS).</p>
            </div>

        </div>


        <!-- 2. Academic & Computer Engineering Alliances (6 Items - Symmetrical 3 Columns / 2 Columns on Tablet) -->
        <h3 class="subsection-title" style="margin-top: 60px;" data-i18n="partners-sec2-title">
            Academic & Computer Engineering Alliances
        </h3>

        <div class="partner-grid">

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/cpe.svg" alt="Department of Computer Engineering" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-cpe-title">Department of Computer Engineering (มทร.อีสาน)</h3>
                <p data-i18n="partner-cpe-desc">สาขาวิชาวิศวกรรมคอมพิวเตอร์ คณะวิศวกรรมศาสตร์ มทร.อีสาน ขอนแก่น · วิจัยร่วมด้าน Embedded Systems, Edge AI, FPGA Computing และสถาปัตยกรรมฮาร์ดแวร์ประมวลผลความเร็วสูง</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/ece-phd.svg" alt="Ph.D. in Electrical and Computer Engineering" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-ece-phd-title">Ph.D. in Electrical & Computer Engineering (ECE)</h3>
                <p data-i18n="partner-ece-phd-desc">หลักสูตรวิศวกรรมศาสตรดุษฎีบัณฑิต สาขาวิชาวิศวกรรมไฟฟ้าและคอมพิวเตอร์ · การผลิตงานวิจัยขั้นสูงด้าน DSP Pipelines, Machine Learning on FPGA และ Real-time Transceiver Systems</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/rmuti.png" alt="RMUTI Khon Kaen Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-rmuti-title">RMUTI Khon Kaen Campus</h3>
                <p data-i18n="partner-rmuti-desc">Faculty of Engineering, Department of Electronics & Telecommunication Engineering · Home laboratory and national engineering research center.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/upb.svg" alt="Paderborn University Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-upb-title">Paderborn University (UPB)</h3>
                <p data-i18n="partner-upb-desc">Germany · Joint research on Coherent Optical OFDM, advanced optical modulation, and high-speed digital signal processing algorithms.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/kku.svg" alt="Khon Kaen University Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-kku-title">Khon Kaen University (KKU)</h3>
                <p data-i18n="partner-kku-desc">Faculty of Engineering & AI Engineering Institute · Academic consortium, co-organizing international conferences, and AI/telecom research exchange.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/mut.png" alt="MUT Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-mut-title">Mahanakorn University of Technology (MUT)</h3>
                <p data-i18n="partner-mut-desc">Academic network and collaborative seminars in advanced Photonics, satellite communication concepts, and space technology innovation.</p>
            </div>

        </div>


        <!-- 3. Academic Consortiums & Professional Societies (4 Items - Symmetrical 4 Columns / 2x2 on Tablet) -->
        <h3 class="subsection-title" style="margin-top: 60px;" data-i18n="partners-sec3-title">
            Academic Consortiums & Professional Societies
        </h3>

        <div class="partner-grid-4">

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/ecti.svg" alt="ECTI Association Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-ecti-title">ECTI Association</h3>
                <p data-i18n="partner-ecti-desc">Electrical Engineering/Electronics, Computer, Telecommunications and IT Association · General Chair & Technical Committee for ECTI-CON 2024.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/eeaat.svg" alt="EEAAT Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-eeaat-title">EEAAT / EECON Network</h3>
                <p data-i18n="partner-eeaat-desc">Electrical Engineering Academic Association (Thailand) · Annual EECON Conference leadership, technical committees, and Best Paper Award recognition.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/eenet.svg" alt="EENET Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-eenet-title">9 RMUTs Engineering Network (EENET)</h3>
                <p data-i18n="partner-eenet-desc">Academic sub-committee network across 9 Rajamangala Universities for curriculum standards and collaborative engineering research.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/ieee.svg" alt="IEEE Thailand Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-ieee-title">IEEE Thailand Section</h3>
                <p data-i18n="partner-ieee-desc">IEEE Communications and Signal Processing Societies · Global technical standards, publication tracks, and professional academic exchange.</p>
            </div>

        </div>


        <!-- 4. Youth Innovation & STEM Outreach (3 Items - Symmetrical 3 Columns) -->
        <h3 class="subsection-title" style="margin-top: 60px;" data-i18n="partners-sec4-title">
            Youth Innovation & STEM Education Outreach
        </h3>

        <div class="partner-grid">

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/youth.png" alt="Innovative Youth Project" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-youth-title">Youth Innovation Project</h3>
                <p data-i18n="partner-youth-desc">Judging committee and technical mentorship for student innovators developing AIoT, embedded systems, and smart electronic solutions.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/kss.svg" alt="Kham Sakaesaeng School" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-kss-title">Kham Sakaesaeng School</h3>
                <p data-i18n="partner-kss-desc">Science & Technology hands-on workshops for special classroom students (ISP & EIS) and pre-engineering university guidance.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/bonlab-ws.svg" alt="BONLAB Hands-on Workshops" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-ws-title">BONLAB Hands-on Engineering Workshops</h3>
                <p data-i18n="partner-ws-desc">Specialized practical training in FPGA digital design, MATLAB/Simulink programming, Arduino microcontrollers, and IoT sensor circuit assembly.</p>
            </div>

        </div>


        <!-- 5. Government & National Research Funding (4 Items - Symmetrical 4 Columns / 2x2 on Tablet) -->
        <h3 class="subsection-title" style="margin-top: 60px;" data-i18n="partners-sec6-title">
            Government & National Research Funding
        </h3>

        <div class="partner-grid-4">

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/nrct.svg" alt="NRCT Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-nrct-title">National Research Council of Thailand (NRCT)</h3>
                <p data-i18n="partner-nrct-desc">National research grants supporting high-impact telecommunication, wireless sensors, and digital innovation projects.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/tsri.svg" alt="TSRI Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-tsri-title">Thailand Science Research and Innovation (TSRI)</h3>
                <p data-i18n="partner-tsri-desc">Strategic funding for frontier science, fundamental research, and technology commercialization frameworks.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/pmub.svg" alt="PMU-B Logo" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-pmub-title">PMU-B</h3>
                <p data-i18n="partner-pmub-desc">Program Management Unit for Human Resources & Institutional Development, Research and Innovation in deep tech and space fields.</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">
                    <img src="/assets/logos/rmutifund.svg" alt="RMUTI Research Fund" loading="lazy" width="76" height="76" />
                </div>
                <h3 data-i18n="partner-rmutifund-title">RMUTI Research Fund</h3>
                <p data-i18n="partner-rmutifund-desc">Institutional research grants and laboratory capability development support at RMUTI Khon Kaen Campus.</p>
            </div>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="cta-box">

            <span class="eyebrow light" data-i18n="partners-cta-eyebrow">
                PARTNERSHIP OPPORTUNITY
            </span>

            <h2 data-i18n="partners-cta-title">
                Partner with BONLAB
            </h2>

            <p data-i18n="partners-cta-desc">
                Whether you represent a university research group, industrial firm, educational institution, or government agency, we invite you to discuss joint research, technology development, and educational initiatives.
            </p>

            <a href="/contact.html" class="button button-white" data-i18n="partners-cta-btn">
                Start a conversation →
            </a>

        </div>

    </div>

</section>
</Layout>
