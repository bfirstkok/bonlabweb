---
import Layout from "../layouts/Layout.astro";

const title = "Partners & Collaborators — BONLAB";
const description = "Academic, industry, and government research partners collaborating with BONLAB, RMUTI Khon Kaen Campus.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            COLLABORATION & ALLIANCES
        </span>

        <h1>
            Research Strengthened through Partnership
        </h1>

        <p>
            BONLAB actively collaborates with domestic and international academic institutions, telecommunication industries, and national research funding bodies.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                OUR NETWORK
            </span>

            <h2>
                Academic Alliances
            </h2>

            <p>
                Joint academic initiatives, graduate research supervision, and scientific knowledge exchange.
            </p>

        </div>


        <div class="partner-grid">

            <div class="partner-card">
                <div class="partner-logo">RMUTI</div>
                <h3>RMUTI Khon Kaen Campus</h3>
                <p>Faculty of Engineering, Department of Electronics & Telecommunication</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">UPB</div>
                <h3>Paderborn University</h3>
                <p>Germany · Optical Communication Systems & Coherent Optical OFDM</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">EECON</div>
                <h3>EECON Network</h3>
                <p>Electrical Engineering Conference & Thai Academic Consortium</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">IEEE</div>
                <h3>IEEE Thailand Section</h3>
                <p>IEEE Communications & Signal Processing Societies</p>
            </div>

        </div>


        <h3 class="subsection-title" style="margin-top: 48px;">
            Industry & Technology Partners
        </h3>

        <div class="partner-grid">

            <div class="partner-card">
                <div class="partner-logo">OPT</div>
                <h3>Optical Communications Industry</h3>
                <p>Fiber Optic Networks & Optical Front-End Development</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">FPGA</div>
                <h3>Embedded Systems & FPGA</h3>
                <p>High-Speed Digital Logic & Hardware Acceleration</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">TEL</div>
                <h3>Telecommunications Equipment</h3>
                <p>Wireless & Optical Transmission Hardware</p>
            </div>

        </div>


        <h3 class="subsection-title" style="margin-top: 48px;">
            Government & Funding Bodies
        </h3>

        <div class="partner-grid">

            <div class="partner-card">
                <div class="partner-logo">NRCT</div>
                <h3>NRCT (วช.)</h3>
                <p>National Research Council of Thailand · Research Grants</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">TSRI</div>
                <h3>TSRI (สกสว.)</h3>
                <p>Thailand Science Research and Innovation Funding</p>
            </div>

            <div class="partner-card">
                <div class="partner-logo">FUND</div>
                <h3>RMUTI Research Fund</h3>
                <p>University Research & Laboratory Development Grants</p>
            </div>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="cta-box">

            <span class="eyebrow light">
                PARTNERSHIP OPPORTUNITY
            </span>

            <h2>
                Partner with BONLAB
            </h2>

            <p>
                Whether you represent a university research group, industrial firm, or public agency, we invite you to discuss joint research and technology development.
            </p>

            <a href="contact.html" class="button button-white">
                Start a conversation →
            </a>

        </div>

    </div>

</section>
</Layout>
