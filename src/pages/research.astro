---
import Layout from "../layouts/Layout.astro";
import researchList from "../data/research.json";

const title = "Research — BONLAB | Broadband Optical Network Laboratory";
const description = "Explore BONLAB research projects in 128-QAM SC-FDM optical wireless communications, underwater VLC monitoring, FPGA real-time DSP transceivers, and low phase noise PLL.";
---


<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow" data-i18n="research-hero-eyebrow">RESEARCH & INNOVATION</span>
        <h1 data-i18n="research-hero-title">Turning Communication Theory into Hardware</h1>
        <p data-i18n="research-hero-desc">Developing wireless, optical, and high-speed digital communication systems from theoretical mathematical models and simulations to validated physical prototypes on FPGA and laboratory testbeds.</p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow" data-i18n="research-sec1-eyebrow">CORE RESEARCH INTERESTS</span>
            <h2 data-i18n="research-sec1-title">Key Research Areas</h2>

        </div>


        <div class="card-grid three-columns">

            <article class="feature-card">

                <div class="card-icon">📡</div>

                <h3 data-i18n="research-card1-title">Advanced Modulation Formats</h3>
                <p data-i18n="research-card1-desc">Design and experimental evaluation of high-order modulation formats including 128-QAM, SC-FDM, and coherent optical OFDM for wireless and optical communications.</p>

            </article>


            <article class="feature-card">

                <div class="card-icon">🧩</div>

                <h3 data-i18n="research-card2-title">FPGA Prototyping & Real DSP</h3>
                <p data-i18n="research-card2-desc">Realization of real-time communication transceiver prototypes using high-speed FPGA hardware pipelines, digital filtering, and hardware acceleration engines.</p>

            </article>


            <article class="feature-card">

                <div class="card-icon">🌊</div>

                <h3 data-i18n="research-card3-title">Underwater VLC & Optical Wireless</h3>
                <p data-i18n="research-card3-desc">Visible Light Communication (VLC) systems for aquatic environmental monitoring, optical wireless sensor networks, and high-throughput point-to-point links.</p>

            </article>

            <article class="feature-card">

                <div class="card-icon">⚙️</div>

                <h3 data-i18n="research-card4-title">Low Phase Noise PLL Design</h3>
                <p data-i18n="research-card4-desc">Design and optimization of low phase-noise phase-locked loops (PLL) for carrier recovery and frequency synthesis in wireless and optical transceivers.</p>

            </article>

            <article class="feature-card">

                <div class="card-icon">🩺</div>

                <h3 data-i18n="research-card5-title">Smart Optical Sensors & Healthcare</h3>
                <p data-i18n="research-card5-desc">Photonic and optical sensor integration with microcontrollers (Arduino, ESP32) for patient monitoring, medical devices, and industrial automation.</p>

            </article>

            <article class="feature-card">

                <div class="card-icon">🌐</div>

                <h3 data-i18n="research-card6-title">Optical Network Architecture</h3>
                <p data-i18n="research-card6-desc">Coherent optical transmission, dispersion compensation, and next-generation broadband optical network infrastructure analysis.</p>

            </article>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow" data-i18n="research-sec-featured-eyebrow">ACTIVE & COMPLETED PROJECTS</span>
            <h2 data-i18n="research-sec-featured-title">Featured Research Projects</h2>
            <p data-i18n="research-sec-featured-desc">Hands-on projects bridging mathematical signal design with laboratory verification.</p>

        </div>


        <div class="project-grid">
            {researchList.map((item) => (
                <article class="project-card">
                    <img class="project-image" src={item.image} alt={item.title}>
                    <div class="project-content">
                        <small>{item.category}</small>
                        <h3>{item.title}</h3>
                        <p style="font-size: 13px; color: var(--muted); margin-bottom: 8px;">
                            <strong data-i18n="research-author-label">ผู้วิจัย:</strong> {item.authors}
                        </p>
                        <p data-th={item.summary} data-en={item.summaryEn || item.summary}>{item.summary}</p>
                        <div style="display: flex; gap: 12px; align-items: center; margin-top: 14px; flex-wrap: wrap;">
                            <a class="button button-primary" style="padding: 6px 14px; font-size: 12.5px; color: #ffffff !important; display: inline-flex; align-items: center; gap: 6px;" href={`research-detail.html?id=${item.id}`}>
                                <span>📖</span> <span style="color: #ffffff !important;" data-i18n="research-read-blog">อ่านสรุปงานวิจัย (Blog) →</span>
                            </a>
                            {item.paperUrl && (
                                <a class="text-link" style="font-size: 12px;" href={item.paperUrl} target="_blank" rel="noopener">
                                    <span data-i18n="research-full-paper">ฉบับเต็ม</span> ({item.journal.split('/')[0].trim()}) ↗
                                </a>
                            )}
                        </div>
                    </div>
                </article>
            ))}
        </div>


    </div>

</section>


<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow" data-i18n="research-awards-eyebrow">AWARDS & RECOGNITION</span>
            <h2 data-i18n="research-awards-title">Research Awards & Milestones</h2>

        </div>


        <div class="publication-list">

            <article class="publication">

                <span class="publication-year">
                    EECON-40
                </span>

                <div>

                    <h3 data-i18n="award-eecon40-title">Best Paper Award</h3>
                    <p data-i18n="award-eecon40-desc"><strong>Assoc. Prof. Dr. Kidsanapong Puntsri</strong> · Electrical Engineering Conference (EECON-40), Thailand.</p>

                </div>

            </article>


            <article class="publication">

                <span class="publication-year">
                    EECON-38
                </span>

                <div>

                    <h3 data-i18n="award-eecon38-title">Best Paper Award</h3>
                    <p data-i18n="award-eecon38-desc"><strong>Assoc. Prof. Dr. Kidsanapong Puntsri</strong> · Electrical Engineering Conference (EECON-38), Thailand.</p>

                </div>

            </article>


            <article class="publication">

                <span class="publication-year">
                    MILESTONE
                </span>

                <div>

                    <h3 data-i18n="award-milestone-title">128-QAM SC-FDM Optical Transmission Demonstrated</h3>
                    <p data-i18n="award-milestone-desc">Laboratory verification of high-order modulation format over free-space optical channel with full constellation synchronization.</p>

                </div>

            </article>

        </div>

    </div>

</section>


<section class="section section-gray">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow" data-i18n="research-sec5-eyebrow">PEER REVIEW & ACADEMIC SERVICE</span>
            <h2 data-i18n="research-sec5-title">International Journal Reviewer</h2>
            <p data-i18n="research-sec5-desc">BONLAB faculty and researchers regularly review research manuscripts for leading global journals:</p>
        </div>
        <div class="card-grid three-columns">
            <article class="feature-card">
                <h3>IEEE Transactions on Signal Processing</h3>
                <p data-i18n="journal-sp-desc">Top journal for signal processing algorithms and theoretical advances.</p>
            </article>
            <article class="feature-card">
                <h3>IEEE Communications Letters</h3>
                <p data-i18n="journal-cl-desc">High-impact publication on emerging wireless and optical communication technologies.</p>
            </article>
            <article class="feature-card">
                <h3>Optical Fiber Technology (Elsevier)</h3>
                <p data-i18n="journal-oft-desc">International journal on optical communications, photonics, and guided wave systems.</p>
            </article>
            <article class="feature-card">
                <h3>Optik (Elsevier)</h3>
                <p data-i18n="journal-optik-desc">International journal for light and electron optics, laser applications, and photonics.</p>
            </article>
            <article class="feature-card">
                <h3>IEEE Photonics Technology Letters</h3>
                <p data-i18n="journal-ptl-desc">Rapid publication of novel developments in photonic and optical communication devices.</p>
            </article>
            <article class="feature-card">
                <h3>Thailand Electrical Engineering Journal</h3>
                <p data-i18n="journal-thai-desc">Serving as editorial member and peer reviewer for national engineering research.</p>
            </article>
        </div>
    </div>
</section>
</Layout>
