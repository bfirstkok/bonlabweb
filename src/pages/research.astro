---
import Layout from "../layouts/Layout.astro";

const title = "Research — BONLAB | Broadband Optical Network Laboratory";
const description = "Explore BONLAB research projects in 128-QAM SC-FDM optical wireless communications, underwater VLC monitoring, FPGA real-time DSP transceivers, IoT smart healthcare, and low phase noise PLL.";
