---
import Layout from "../layouts/Layout.astro";

const title = "Research — BONLAB | Broadband Optical Network Laboratory";
const description = "Explore BONLAB research projects in 128-QAM SC-FDM optical wireless communications, underwater VLC monitoring, FPGA real-time DSP transceivers, and low phase noise PLL.";
---

<Layout title={title} description={description}>
<section class="page-hero">

    <div class="container">

        <span class="eyebrow">
            RESEARCH & INNOVATION
        </span>

        <h1>
            Turning Communication Theory into Hardware
        </h1>

        <p>
            Developing wireless, optical, and high-speed digital communication systems from theoretical mathematical models and simulations to validated physical prototypes on FPGA and laboratory testbeds.
        </p>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                CORE RESEARCH INTERESTS
            </span>

            <h2>
                Key Research Areas
            </h2>

        </div>


        <div class="card-grid three-columns">

            <article class="feature-card">

                <div class="card-icon">📡</div>

                <h3>
                    Advanced Modulation Formats
                </h3>

                <p>
                    Design and experimental evaluation of high-order modulation formats including 128-QAM, SC-FDM, and coherent optical OFDM for wireless and optical communications.
                </p>

            </article>


            <article class="feature-card">

                <div class="card-icon">🧩</div>

                <h3>
                    FPGA Prototyping & Real DSP
                </h3>

                <p>
                    Realization of real-time communication transceiver prototypes using high-speed FPGA hardware pipelines, digital filtering, and hardware acceleration engines.
                </p>

            </article>


            <article class="feature-card">

                <div class="card-icon">🌊</div>

                <h3>
                    Underwater VLC & Optical Wireless
                </h3>

                <p>
                    Visible Light Communication (VLC) systems for aquatic environmental monitoring, optical wireless sensor networks, and high-throughput point-to-point links.
                </p>

            </article>

            <article class="feature-card">

                <div class="card-icon">⚙️</div>

                <h3>
                    Low Phase Noise PLL Design
                </h3>

                <p>
                    Design and optimization of low phase-noise phase-locked loops (PLL) for carrier recovery and frequency synthesis in wireless and optical transceivers.
                </p>

            </article>

            <article class="feature-card">

                <div class="card-icon">🩺</div>

                <h3>
                    Smart Optical Sensors & Healthcare
                </h3>

                <p>
                    Photonic and optical sensor integration with microcontrollers (Arduino, ESP32) for patient monitoring, medical devices, and industrial automation.
                </p>

            </article>

            <article class="feature-card">

                <div class="card-icon">🌐</div>

                <h3>
                    Optical Network Architecture
                </h3>

                <p>
                    Coherent optical transmission, dispersion compensation, and next-generation broadband optical network infrastructure analysis.
                </p>

            </article>

        </div>

    </div>

</section>


<section class="section section-gray">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                ACTIVE & COMPLETED PROJECTS
            </span>

            <h2>
                Featured Research Projects
            </h2>

            <p>
                Hands-on projects bridging mathematical signal design with laboratory verification.
            </p>

        </div>


        <div class="project-grid">

            <article class="project-card">

                <img class="project-image" src="assets/research-128qam-scfdm.jpg" alt="128-QAM SC-FDM Optical Wireless Communication System">

                <div class="project-content">

                    <small>
                        OPTICAL WIRELESS COMMUNICATIONS
                    </small>

                    <h3>
                        128-QAM SC-FDM Optical Wireless System
                    </h3>

                    <p>
                        Successful transmission and real-time demodulation of 128-QAM Single-Carrier Frequency Division Multiplexing over optical wireless links, achieving low PAPR and high data rate.
                    </p>

                    <a href="research-detail.html">
                        Read project details →
                    </a>

                </div>

            </article>


            <article class="project-card">

                <img class="project-image" src="assets/bonlab-lab-cover.jpg" alt="Underwater Environmental Monitoring using VLC">

                <div class="project-content">

                    <small>
                        VISIBLE LIGHT COMMUNICATION (VLC)
                    </small>

                    <h3>
                        Underwater Monitoring using VLC
                    </h3>

                    <p>
                        Optical wireless sensor network designed for aquatic and underwater telemetry where traditional radio frequency signals suffer extreme attenuation.
                    </p>

                    <a href="research-detail.html">
                        Read project details →
                    </a>

                </div>

            </article>


            <article class="project-card">

                <img class="project-image" src="assets/news-16qam.jpg" alt="Real DSP for High-Speed Transceiver and Low Phase-Noise PLL">

                <div class="project-content">

                    <small>
                        FPGA & HARDWARE PROTOTYPING
                    </small>

                    <h3>
                        Real DSP for High Speed Transceivers
                    </h3>

                    <p>
                        Hardware realization of real-time digital signal processing engines and low phase noise phase-locked loop (PLL) synchronization circuits on FPGA.
                    </p>

                    <a href="research-detail.html">
                        Read project details →
                    </a>

                </div>

            </article>

        </div>

    </div>

</section>


<section class="section">

    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                AWARDS & RECOGNITION
            </span>

            <h2>
                Research Awards & Milestones
            </h2>

        </div>


        <div class="publication-list">

            <article class="publication">

                <span class="publication-year">
                    EECON-40
                </span>

                <div>

                    <h3>
                        Best Paper Award
                    </h3>

                    <p>
                        <strong>Assoc. Prof. Dr. Kidsanapong Puntsri</strong> · Electrical Engineering Conference (EECON-40), Thailand.
                    </p>

                </div>

            </article>


            <article class="publication">

                <span class="publication-year">
                    EECON-38
                </span>

                <div>

                    <h3>
                        Best Paper Award
                    </h3>

                    <p>
                        <strong>Assoc. Prof. Dr. Kidsanapong Puntsri</strong> · Electrical Engineering Conference (EECON-38), Thailand.
                    </p>

                </div>

            </article>


            <article class="publication">

                <span class="publication-year">
                    MILESTONE
                </span>

                <div>

                    <h3>
                        128-QAM SC-FDM Optical Transmission Demonstrated
                    </h3>

                    <p>
                        Laboratory verification of high-order modulation format over free-space optical channel with full constellation synchronization.
                    </p>

                </div>

            </article>

        </div>

    </div>

</section>


<section class="section section-gray">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">PEER REVIEW & ACADEMIC SERVICE</span>
            <h2>International Journal Reviewer</h2>
            <p>BONLAB faculty and researchers regularly review research manuscripts for leading global journals:</p>
        </div>
        <div class="card-grid three-columns">
            <article class="feature-card">
                <h3>IEEE Transactions on Signal Processing</h3>
                <p>Top journal for signal processing algorithms and theoretical advances.</p>
            </article>
            <article class="feature-card">
                <h3>IEEE Communications Letters</h3>
                <p>High-impact publication on emerging wireless and optical communication technologies.</p>
            </article>
            <article class="feature-card">
                <h3>Optical Fiber Technology (Elsevier)</h3>
                <p>International journal on optical communications, photonics, and guided wave systems.</p>
            </article>
            <article class="feature-card">
                <h3>Optik (Elsevier)</h3>
                <p>International journal for light and electron optics, laser applications, and photonics.</p>
            </article>
            <article class="feature-card">
                <h3>IEEE Photonics Technology Letters</h3>
                <p>Rapid publication of novel developments in photonic and optical communication devices.</p>
            </article>
            <article class="feature-card">
                <h3>Thailand Electrical Engineering Journal</h3>
                <p>Serving as editorial member and peer reviewer for national engineering research.</p>
            </article>
        </div>
    </div>
</section>
</Layout>
