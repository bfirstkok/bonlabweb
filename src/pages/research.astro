<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow" data-i18n="research-sec1-eyebrow">
                CORE RESEARCH INTERESTS
            </span>
            <h2 data-i18n="research-sec1-title">
                Key Research Areas
            </h2>
            <p data-i18n="research-sec1-desc">
                Bridging mathematical signal processing algorithms with real hardware realization across optical and wireless domains.
            </p>
        </div>

        <div class="card-grid three-columns">
            <article class="feature-card">
                <div class="card-icon">📡</div>
                <h3 data-i18n="research-card1-title">Advanced Modulation Formats</h3>
                <p data-i18n="research-card1-desc">
                    Design and experimental evaluation of high-order modulation formats including 128-QAM, SC-FDM, and coherent optical OFDM for wireless and optical communications.
                </p>
                <a href="research-detail.html#p1" class="card-link">View Research Details →</a>
            </article>

            <article class="feature-card">
                <div class="card-icon">🧩</div>
                <h3 data-i18n="research-card2-title">FPGA Prototyping & Real DSP</h3>
                <p data-i18n="research-card2-desc">
                    Realization of real-time communication transceiver prototypes using high-speed FPGA hardware pipelines, digital filtering, and hardware acceleration engines.
                </p>
                <a href="research-detail.html#p2" class="card-link">View Research Details →</a>
            </article>

            <article class="feature-card">
                <div class="card-icon">🌊</div>
                <h3 data-i18n="research-card3-title">Underwater VLC & Optical Wireless</h3>
                <p data-i18n="research-card3-desc">
                    Visible Light Communication (VLC) systems for aquatic environmental monitoring, optical wireless sensor networks, and high-throughput point-to-point links.
                </p>
                <a href="research-detail.html#p3" class="card-link">View Research Details →</a>
            </article>

            <article class="feature-card">
                <div class="card-icon">⚙️</div>
                <h3 data-i18n="research-card4-title">Low Phase Noise PLL Design</h3>
                <p data-i18n="research-card4-desc">
                    Design and optimization of low phase-noise phase-locked loops (PLL) for carrier recovery and frequency synthesis in wireless and optical transceivers.
                </p>
                <a href="research-detail.html#p1" class="card-link">View Research Details →</a>
            </article>

            <article class="feature-card">
                <div class="card-icon">🩺</div>
                <h3 data-i18n="research-card5-title">Smart Optical Sensors & Healthcare</h3>
                <p data-i18n="research-card5-desc">
                    Photonic and optical sensor integration with microcontrollers (Arduino, ESP32) for patient vital sign monitoring, medical telemetry, and IoT automation.
                </p>
                <a href="research-detail.html#p4" class="card-link">View Research Details →</a>
            </article>

            <article class="feature-card">
                <div class="card-icon">🌐</div>
                <h3 data-i18n="research-card6-title">Optical Network Architecture</h3>
                <p data-i18n="research-card6-desc">
                    Coherent optical transmission, dispersion compensation, and next-generation broadband optical network infrastructure analysis.
                </p>
                <a href="research-detail.html#p1" class="card-link">View Research Details →</a>
            </article>
        </div>
    </div>
</section>

