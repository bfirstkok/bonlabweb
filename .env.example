BONLAB_ADMIN_USER=adminbonlab
BONLAB_ADMIN_PASSWORD=change-this-password
BONLAB_SESSION_SECRET=replace-with-a-long-random-secret
PORT=8000

# Facebook Graph API (สำหรับดึงข่าวสารและกิจกรรมจาก Facebook Page)
FB_PAGE_ID=100076231050286
# leave empty until the page admin gives a token (see docs/FACEBOOK_FEED.md); a fake value makes every sync fail
FB_PAGE_ACCESS_TOKEN=
FB_FEED_URL=

# Docker deploy: domain Caddy uses for HTTPS (no domain? use <ip-with-dashes>.sslip.io)
SITE_ADDRESS=34-1-2-3.sslip.io

# Image from GitHub Container Registry. Staging (GCP): main (auto-deploys every merge).
# Production (university): pin a release, e.g. v1.0.0, and change it to upgrade.
BONLAB_TAG=main
